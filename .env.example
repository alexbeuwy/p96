# Copy to .env.local (git-ignored) and fill in.
#
# Storage-zone password from Bunny dashboard → Storage → beuwy →
# "FTP & API Access". This grants full read/write/delete on the zone, so it
# stays out of git and out of anything the browser can see. It is NOT a
# VITE_ variable on purpose — those get inlined into the client bundle.
BUNNY_STORAGE_KEY=

# Storage zone name and its region endpoint.
BUNNY_STORAGE_ZONE=beuwy
BUNNY_STORAGE_HOST=storage.bunnycdn.com

# Ordner in der Zone. Achtung: Bunny-Pfade sind case-sensitiv — der Ordner
# heißt P96, nicht p96. Mit Kleinschreibung legt der Upload stillschweigend
# einen zweiten, leeren Ordner an, statt zu überschreiben.
BUNNY_PREFIX=P96
